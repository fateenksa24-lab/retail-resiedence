# Retal Residence: static site for Apache hosting.

Options -Indexes
DirectoryIndex index.html index.php
AddDefaultCharset UTF-8
AddType image/avif .avif
AddType image/webp .webp
AddType application/manifest+json .webmanifest

ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<Files "apple-icon">
  ForceType image/png
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # One host: www.retalresidence.com -> retalresidence.com
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Old WordPress pages -> their new homes, so links and rankings carry over.
  RewriteRule ^contact/?$ /en/contact/ [L,R=301]
  RewriteRule ^the-building/?$ /en/residences/ [L,R=301]
  RewriteRule ^ipanorama/virtualtour/.*$ /en/clubhouse/ [L,R=301]
  RewriteRule ^retal-residence-francais/?$ /fr/ [L,R=301]
  RewriteRule ^retal-residence-italiano/?$ /it/ [L,R=301]
  RewriteRule ^retal-residence-aragones/?$ /es/ [L,R=301]
  RewriteRule ^(about|faq|blog|landingpage)/?$ /en/ [L,R=301]
  RewriteRule ^wp-sitemap.*\.xml$ /sitemap.xml [L,R=301]

  # WordPress leftovers that no longer exist: tell search engines they are gone for good.
  RewriteRule ^(sample-page|icon|elementor-hf|author|feed|comments/feed|wp-admin|wp-includes|wp-content|wp-json)(/.*)?$ - [G,L]
  RewriteRule ^(xmlrpc|wp-login|wp-cron|wp-signup)\.php$ - [G,L]

  # The home page opens in the browser's language when the site has it, English otherwise.
  RewriteCond %{HTTP:Accept-Language} ^(ar|fr|it|es|zh|ko) [NC]
  RewriteRule ^$ /%1/ [L,R=302]
  RewriteRule ^$ /en/ [L,R=302]

  # Pages live in folders: /en/residences -> /en/residences/
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Hashed build files and images never change: cache for a year.
  <FilesMatch "\.(js|css|woff2|jpg|jpeg|png|webp|avif|svg|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages: always check for a new version.
  <FilesMatch "\.(html|txt|xml|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
